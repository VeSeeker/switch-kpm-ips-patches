@nsobid-9224BD2BC211DB440C0F3D710F0C404C2B5BF01E000000000000000000000000

@flag offset_shift 0x100

@enabled

// Target game: Kotor 1
// Target version: 1.0.3

// Fixes a bug unique to the Switch version where the highest quality
// mipmap wouldn't appear animated


// Preserve the non-power-of-two sampler condition without ORing in the
// animated flag

// Original:
//  001d668c 14 01 14 2A    orr w20,w8,w20

// Replacement:
001d668c f403082a       //  mov w20,w8


// Compressed path: use the selected animation frame for the base mip upload

// Original:
//  001d6ee4 E0 03 1B AA    mov param_1,x27

// Replacement:
001d6ee4 e00317aa       //  mov param_1,x23
