@nsobid-814D285CFA9F4AADC0E8BC151AE3B5EE25F60E5A000000000000000000000000

@flag offset_shift 0x100

@enabled

// AnimatedTextureFix

// Target game: Kotor 1 (Switch 1.0.4)

// Fixes a bug unique to the Switch version where the highest quality
// mipmap wouldn't appear animated


// Preserve the non-power-of-two sampler condition without ORing in the
// animated flag

// Original:
//  00135354 14 01 14 2A    orr w20,w8,w20

// Replacement:
00135354 f403082a       //  mov w20,w8


// Compressed path: use the selected animation frame for the base mip upload

// Original:
//  00135bac E0 03 1B AA    mov param_1,x27

// Replacement:
00135bac e00317aa       //  mov param_1,x23
